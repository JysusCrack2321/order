// Ventana principal de ORDER: cabecera, pestañas, avisos, pie y formularios.
// Los colores, tamaños y familias salen siempre de tema.slint.

import { Tema } from "tema.slint";
import { SemanaVista, DiaUI } from "semana.slint";
import { PendientesVista, TareaUI } from "pendientes.slint";
import { InicioVista } from "inicio.slint";
import { DiaVista } from "dia.slint";
import { ClaseInicioUI, ConteoMateriaUI, RecordatorioInicioUI } from "listas.slint";
import { Marco, Campo, CampoBoton, CampoClave, Chip, Casilla, Boton, Etiqueta, RecordatorioUI, CalendarioUI, DispositivoUI } from "formularios.slint";
import { Selector, CeldaDia, MateriaUI } from "selectores.slint";
import { AccionUI, AdjuntoUI, BarraAgente, PanelAgente, TarjetaConexionAgente } from "agente.slint";
import { ScrollView } from "std-widgets.slint";

component Pestana inherits Rectangle {
    in property <string> texto;
    in property <bool> activa: false;
    callback clicked();

    width: Tema.ancho-pestana;
    height: Tema.alto-cabecera - 2 * Tema.espacio-md;
    border-radius: Tema.radio-pequeno;
    background: ta.has-hover ? Tema.fondo-hover : transparent;

    Text {
        y: 0;
        width: parent.width;
        height: parent.height - Tema.trazo;
        horizontal-alignment: center;
        vertical-alignment: center;
        text: root.texto;
        font-family: Tema.fuente-titulos;
        font-size: Tema.tamano-pestana;
        letter-spacing: Tema.letra-normal;
        color: root.activa ? Tema.acento : Tema.texto-suave;
    }

    Rectangle {
        y: parent.height - Tema.trazo;
        width: parent.width;
        height: Tema.trazo;
        background: root.activa ? Tema.acento : transparent;
    }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component BotonCabecera inherits Rectangle {
    in property <string> texto;
    in property <length> ancho: Tema.ancho-boton-tarea;
    callback clicked();

    width: root.ancho;
    height: Tema.alto-boton;
    border-radius: Tema.radio;
    background: ta.has-hover ? Tema.acento-tenue : transparent;
    border-width: Tema.linea;
    border-color: ta.has-hover ? Tema.acento : Tema.acento-suave;

    Text {
        width: parent.width;
        height: parent.height;
        horizontal-alignment: center;
        vertical-alignment: center;
        text: root.texto;
        font-family: Tema.fuente-titulos;
        font-size: Tema.tamano-pequeno;
        letter-spacing: Tema.letra-normal;
        color: ta.has-hover ? Tema.acento : Tema.texto-suave;
    }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component Banner inherits Rectangle {
    in property <string> titulo;
    in property <[string]> lineas;
    in property <color> fondo-color;
    in property <color> filo;
    in property <color> tinta;

    background: fondo-color;
    height: 2 * Tema.espacio-sm + (1 + lineas.length) * Tema.alto-linea-aviso;
    clip: true;

    Rectangle {
        x: 0;
        y: 0;
        width: Tema.ancho-marca;
        height: parent.height;
        background: filo;
    }

    VerticalLayout {
        x: Tema.espacio-md;
        y: Tema.espacio-sm;
        width: parent.width - 2 * Tema.espacio-md;
        spacing: 0;

        Text {
            height: Tema.alto-linea-aviso;
            vertical-alignment: center;
            text: root.titulo;
            font-size: Tema.tamano-pequeno;
            font-weight: 600;
            color: tinta;
            overflow: elide;
        }

        for linea in root.lineas : Text {
            height: Tema.alto-linea-aviso;
            vertical-alignment: center;
            text: linea;
            font-size: Tema.tamano-hora;
            color: tinta;
            overflow: elide;
        }
    }
}

component BannerConflicto inherits Rectangle {
    in property <string> mensaje;
    in property <string> texto-principal: "Quedarme con la actual";
    in property <string> texto-secundario: "Usar la otra";
    callback quedar-actual();
    callback usar-otra();

    background: Tema.fondo-aviso;
    height: Tema.alto-boton + 2 * Tema.espacio-sm;
    clip: true;

    Rectangle {
        x: 0;
        y: 0;
        width: Tema.ancho-marca;
        height: parent.height;
        background: Tema.borde-aviso;
    }

    HorizontalLayout {
        x: Tema.espacio-md;
        y: 0;
        width: parent.width - 2 * Tema.espacio-md;
        height: parent.height;
        spacing: Tema.espacio-sm;
        alignment: start;

        Text {
            horizontal-stretch: 1;
            height: parent.height;
            vertical-alignment: center;
            text: root.mensaje;
            font-size: Tema.tamano-pequeno;
            font-weight: 600;
            color: Tema.texto-aviso;
            overflow: elide;
        }

        VerticalLayout {
            alignment: center;
            Boton {
                texto: root.texto-principal;
                principal: true;
                width: Tema.ancho-boton-largo;
                clicked => { root.quedar-actual(); }
            }
        }

        VerticalLayout {
            alignment: center;
            Boton {
                texto: root.texto-secundario;
                width: Tema.ancho-boton-form;
                clicked => { root.usar-otra(); }
            }
        }
    }
}

export component AppWindow inherits Window {
    title: "ORDER";
    // Icono de la ventana: el mismo reloj de arena de la bandeja y del .desktop.
    icon: @image-url("../arte/order.svg");
    no-frame: true;
    // Sin tamaño fijo: la ventana se adapta al tamaño que le dé el
    // compositor y el contenido la llena entera. Solo se pone un mínimo.
    min-width: Tema.ancho-minimo-ventana;
    min-height: Tema.alto-minimo-ventana;
    background: Tema.fondo;
    default-font-family: Tema.fuente-texto;
    default-font-size: Tema.tamano-texto;

    // --- Datos que pone puente.rs ----------------------------------------
    in-out property <int> pestana: 0;
    in property <string> error: "";
    in property <[string]> advertencias: [];
    in property <string> conflicto-texto: "";
    in property <string> moodle-banner: "";
    in property <string> ical-oferta: "";
    in property <string> pie: "";

    in property <[DiaUI]> dias;
    in property <string> etiqueta-semana: "";
    in property <bool> es-semana-actual: false;
    in property <int> base-hora: 7;
    in property <int> fin-hora: 19;
    in property <[string]> etiquetas-hora;
    in property <bool> mostrar-ahora: false;
    in property <int> ahora-min: 0;
    in property <bool> hay-tareas: false;

    in property <[TareaUI]> tareas;
    in property <string> resumen-pendientes: "";
    in property <[RecordatorioUI]> recordatorios;

    // --- Inicio (el tablero del día) --------------------------------------
    in property <string> inicio-fecha: "";
    in property <[ClaseInicioUI]> inicio-clases;
    in property <bool> inicio-hay-siguiente: false;
    in property <ClaseInicioUI> inicio-siguiente;
    in property <[TareaUI]> inicio-vencidas;
    in property <[TareaUI]> inicio-de-hoy;
    in property <[TareaUI]> inicio-proximas;
    in property <[RecordatorioInicioUI]> inicio-recordatorios;
    in property <[ConteoMateriaUI]> inicio-por-materia;

    // --- Día --------------------------------------------------------------
    in property <string> dia-etiqueta: "";
    in property <bool> dia-es-hoy: false;
    in property <[ClaseInicioUI]> dia-clases;
    in property <[TareaUI]> dia-tareas;
    in property <[RecordatorioInicioUI]> dia-recordatorios;

    // --- Barra de filtros de Pendientes (la pone puente.rs) ---------------
    // Los valores llegan ya resueltos: aquí solo se dibujan.
    in property <string> pm-materia: "";
    // 0 = todas · 1 = hoy · 2 = esta semana · 3 = rango
    in property <int> pm-fecha: 0;
    in property <string> pm-desde: "";
    in property <string> pm-hasta: "";
    in property <string> pm-hora-desde: "";
    in property <string> pm-hora-hasta: "";
    in property <bool> pm-mostrar-hechas: true;
    in property <bool> pm-filtro-activo: false;

    // --- Estado del formulario abierto -----------------------------------
    // 0 = ninguno · 1 = tarea · 2 = clase · 3 = ajustes · 4 = recordatorio · 5 = agente · 6 = moodle
    in-out property <int> formulario: 0;
    in property <string> form-encabezado: "";
    in property <string> form-sub: "";
    in property <bool> form-edita: false;
    in property <string> form-error: "";
    // Campo marcado por la validación. El significado depende del formulario:
    // tarea (1 título, 2 fecha, 3 hora), clase (1 materia, 2 inicio, 3 fin),
    // recordatorio (1 texto, 2 hora, 4 días), ajustes (1/2 semestre, 3 hora
    // del aviso, 4 horas antes).
    in property <int> campo-mal: 0;
    in-out property <bool> form-confirma: false;

    // Campos de tarea y de clase (solo hay un formulario abierto a la vez).
    in-out property <string> f-titulo: "";
    in-out property <string> f-materia: "";
    in-out property <string> f-fecha: "";
    in-out property <string> f-hora: "";
    in-out property <string> f-fin: "";
    in-out property <string> f-lugar: "";
    in-out property <bool> f-hecha: false;
    in property <string> f-enlace: "";

    // Días de la clase: se eligen varios (al menos uno).
    in-out property <bool> f-lun: false;
    in-out property <bool> f-mar: false;
    in-out property <bool> f-mie: false;
    in-out property <bool> f-jue: false;
    in-out property <bool> f-vie: false;
    in-out property <bool> f-sab: false;
    in-out property <bool> f-dom: false;

    // Campos de recordatorio.
    in-out property <string> r-texto: "";
    in-out property <string> r-hora: "";
    in-out property <bool> r-lun: false;
    in-out property <bool> r-mar: false;
    in-out property <bool> r-mie: false;
    in-out property <bool> r-jue: false;
    in-out property <bool> r-vie: false;
    in-out property <bool> r-sab: false;
    in-out property <bool> r-dom: false;

    // Campos de ajustes.
    in-out property <string> a-inicio: "";
    in-out property <string> a-fin: "";
    in-out property <string> a-hora: "";
    in-out property <string> a-horas: "";
    in-out property <bool> a-sin-semestre: false;
    in-out property <bool> a-autostart: false;

    // --- Agente -----------------------------------------------------------
    // Barra de abajo y panel de propuestas.
    in-out property <string> agente-texto: "";
    in property <bool> agente-pensando: false;
    in property <string> agente-pensando-texto: "pensando…";
    in property <string> agente-respuesta: "";
    in property <[AccionUI]> agente-acciones: [];
    in property <bool> agente-panel: false;
    in property <string> agente-aviso: "";
    in property <string> agente-nota: "";
    in property <bool> agente-grabando: false;
    in property <string> agente-tiempo: "";
    in property <[AdjuntoUI]> agente-adjuntos: [];
    in property <bool> agente-leyendo: false;
    in property <bool> agente-hay-conversacion: false;
    // Tarjeta de conexión guiada (cuando falta la clave).
    in property <bool> conexion-abierta: false;
    in property <string> conexion-titulo: "";
    in property <string> conexion-paso-1: "";
    in property <string> conexion-paso-2: "";
    in property <string> conexion-paso-3: "";
    in property <string> conexion-texto-abrir-studio: "";
    in property <string> conexion-texto-pegar: "";
    in property <string> conexion-etiqueta-clave: "";
    in property <string> conexion-pista-clave: "";
    in property <string> conexion-texto-conectar: "";
    in property <string> conexion-texto-conectando: "";
    in property <string> conexion-texto-otro-proveedor: "";
    in-out property <string> conexion-key: "";
    in-out property <bool> conexion-ver-key: false;
    in property <bool> conexion-conectando: false;
    in property <string> conexion-estado-texto: "";
    in property <bool> conexion-estado-error: false;
    // Ajustes → Agente (el proveedor va por fichas, 0–3).
    in-out property <int> a-proveedor: 0;
    in-out property <string> a-url: "";
    in-out property <string> a-modelo: "";
    in-out property <string> a-key: "";
    in-out property <bool> a-ver-key: false;
    in-out property <bool> a-ve-imagenes: false;
    in-out property <string> a-limite-contexto: "";
    // Ajustes → Agente → Voz (2 = Este PC (gratis), 0 = OpenAI, 1 = Groq).
    in-out property <int> a-voz-proveedor: 2;
    in-out property <string> v-url: "";
    in-out property <string> v-modelo: "";
    in-out property <string> v-key: "";
    in-out property <bool> v-ver-key: false;
    in-out property <bool> a-voz-modelo-listo: false;
    // Diálogo de descarga del modelo de voz local (~470 MB).
    in-out property <bool> descarga-voz-abierta: false;
    in-out property <bool> descarga-voz-en-curso: false;
    in property <float> descarga-voz-progreso: 0.0;
    in property <string> descarga-voz-estado: "";
    in property <string> descarga-voz-error: "";
    // Sección "Avanzado": URL y modelo a mano. Cerrada salvo con "Otro".
    in-out property <bool> a-avanzado: false;

    // --- Ajustes → Moodle -------------------------------------------------
    in property <bool> moodle-conectado: false;
    in property <bool> moodle-requiere-reingreso: false;
    in property <string> moodle-estado-texto: "";
    in property <bool> moodle-ocupado: false;
    in property <string> moodle-aviso: "";
    in-out property <string> m-sitio: "micampus.unal.edu.co";
    in-out property <string> m-usuario: "";
    in-out property <string> m-contrasena: "";
    in-out property <bool> m-ver-pass: false;

    // --- Ajustes → Calendarios --------------------------------------------
    in property <[CalendarioUI]> calendarios: [];
    in property <bool> ical-ocupado: false;
    in property <string> ical-aviso: "";
    in-out property <string> c-url: "";
    in-out property <string> c-nombre: "";
    in-out property <string> c-materia: "";

    // --- Ajustes → Dispositivos (P2P) -------------------------------------
    in property <bool> p2p-sincronizando: false;
    in property <bool> p2p-ocupado: false;
    in property <string> p2p-aviso: "";
    in-out property <string> p2p-nombre: "";
    in property <[DispositivoUI]> p2p-dispositivos: [];
    in property <bool> p2p-mostrando-qr: false;
    in property <image> p2p-qr-imagen;
    in property <string> p2p-palabras: "";
    in property <string> p2p-enlace: "";
    in-out property <string> p2p-codigo-entrada: "";
    // 0 = ninguno · 1 = fecha · 2 = hora · 3 = materia. `sel-campo` dice qué
    // campo del formulario se está llenando; el significado lo pone puente.rs.
    in-out property <int> selector-tipo: 0;
    in property <string> sel-titulo: "";
    in property <string> sel-mes-texto: "";
    in property <[CeldaDia]> sel-celdas: [];
    in property <string> sel-hora-texto: "";
    // Índice de la rueda de horas (0 = 1) y de la de minutos (0 = 00).
    in property <int> sel-hora12: 0;
    in property <int> sel-minuto: 0;
    // ¿La hora elegida es de la tarde? Solo se usa al abrir el selector.
    in property <bool> sel-tarde: false;
    in property <[string]> sel-horas: [];
    in property <[string]> sel-minutos: [];
    in property <[MateriaUI]> sel-materias: [];
    in-out property <string> materia-nueva: "";
    in-out property <bool> materia-escribiendo: false;

    callback semana-anterior();
    callback semana-siguiente();
    callback ir-hoy();
    callback dia-anterior();
    callback dia-siguiente();
    callback dia-hoy();
    callback nueva-tarea();
    callback abrir-ajustes();
    callback editar-tarea(string);
    callback marcar-hecha(string, bool);
    // Filtros de Pendientes. Los campos 21–25 de `abrir-materia`, `abrir-fecha`
    // y `abrir-hora` son los de la barra de filtros (ver puente.rs).
    callback filtro-fecha(int);
    callback filtro-hechas(bool);
    callback filtro-limpiar();
    callback nueva-clase();
    callback editar-clase(string);
    callback nuevo-recordatorio();
    callback editar-recordatorio(string);
    callback guardar-formulario();
    callback cancelar-formulario();
    callback confirmar-borrado();
    callback abrir-fecha(int);
    callback abrir-hora(int);
    callback abrir-materia(int);
    callback selector-cerrar();
    callback selector-mes(int);
    callback selector-dia(int);
    callback selector-hora12(int);
    callback selector-minuto(int);
    callback selector-pm(bool);
    callback selector-aceptar();
    callback selector-escribir();
    callback selector-materia(string);
    // Agente: enviar, cerrar el panel y aplicar o descartar propuestas.
    callback agente-enviar();
    callback agente-cerrar();
    callback agente-aplicar(int);
    callback agente-descartar(int);
    callback agente-aplicar-todas();
    callback agente-adjuntar();
    callback agente-quitar-adjunto(int);
    callback agente-nueva-conversacion();
    callback conexion-abrir-studio();
    callback conexion-pegar();
    callback conexion-alternar-clave();
    callback conexion-conectar();
    callback conexion-otro-proveedor();
    callback conexion-cerrar();
    callback abrir-agente();
    callback abrir-moodle();
    callback moodle-conectar();
    callback moodle-sincronizar();
    callback moodle-desconectar();
    callback abrir-calendarios();
    callback ical-agregar();
    callback ical-quitar(string);
    callback ical-sincronizar();
    callback ical-oferta-aceptar();
    callback ical-oferta-rechazar();
    callback abrir-dispositivos();
    callback p2p-guardar-nombre();
    callback p2p-generar-codigo();
    callback p2p-cerrar-codigo();
    callback p2p-copiar-enlace();
    callback p2p-emparejar();
    callback p2p-quitar(string);
    callback p2p-sincronizar();
    callback abrir-enlace-tarea();
    callback elegir-proveedor(int);
    callback elegir-voz-proveedor(int);
    callback conseguir-clave(int);
    callback conseguir-clave-voz(int);
    callback alternar-avanzado();
    callback alternar-clave();
    callback grabar-voz();
    callback alternar-clave-voz();
    callback descarga-voz-abrir();
    callback descarga-voz-iniciar();
    callback descarga-voz-cancelar();
    callback conflicto-quedar-actual();
    callback conflicto-usar-otra();

    Rectangle {
        width: parent.width;
        height: parent.height;

        VerticalLayout {
            width: parent.width;
            height: parent.height;
            spacing: 0;

            // --- Cabecera -------------------------------------------------
            Rectangle {
                height: Tema.alto-cabecera;
                background: Tema.fondo-panel;

                HorizontalLayout {
                    width: parent.width;
                    height: parent.height;
                    padding-left: Tema.espacio-xl;
                    padding-right: Tema.espacio-xl;
                    spacing: Tema.espacio-md;
                    cross-axis-alignment: center;

                    VerticalLayout {
                        alignment: center;
                        spacing: Tema.separacion-linea;

                        Text {
                            text: "ORDER";
                            font-family: Tema.fuente-titulos;
                            font-size: Tema.tamano-titulo;
                            font-weight: 700;
                            letter-spacing: Tema.letra-titulo;
                            color: Tema.texto;
                        }

                        Text {
                            text: "horario · tareas";
                            font-size: Tema.tamano-hora;
                            letter-spacing: Tema.letra-normal;
                            color: Tema.texto-tenue;
                        }
                    }

                    Rectangle { horizontal-stretch: 1; }

                    HorizontalLayout {
                        spacing: Tema.espacio-xs;
                        cross-axis-alignment: center;

                        Pestana {
                            texto: "Inicio";
                            activa: root.pestana == 0;
                            clicked => { root.pestana = 0; }
                        }

                        Pestana {
                            texto: "Día";
                            activa: root.pestana == 1;
                            clicked => { root.pestana = 1; }
                        }

                        Pestana {
                            texto: "Semana";
                            activa: root.pestana == 2;
                            clicked => { root.pestana = 2; }
                        }

                        Pestana {
                            texto: "Pendientes";
                            activa: root.pestana == 3;
                            clicked => { root.pestana = 3; }
                        }
                    }

                    Rectangle { horizontal-stretch: 1; }

                    if root.p2p-sincronizando : Text {
                        text: "↻ Sincronizando…";
                        font-size: Tema.tamano-hora;
                        color: Tema.acento;
                        vertical-alignment: center;
                    }

                    BotonCabecera {
                        texto: "Ajustes";
                        ancho: Tema.ancho-boton-ajustes;
                        clicked => { root.abrir-ajustes(); }
                    }

                    BotonCabecera {
                        texto: "+  Tarea";
                        clicked => { root.nueva-tarea(); }
                    }
                }

                Rectangle {
                    y: parent.height - Tema.linea;
                    width: parent.width;
                    height: Tema.linea;
                    background: Tema.borde;
                }
            }

            // --- Avisos (no roban el foco ni bloquean la vista) ------------
            if root.error != "" : Banner {
                titulo: root.error;
                lineas: [];
                fondo-color: Tema.fondo-error;
                filo: Tema.borde-error;
                tinta: Tema.texto-error;
            }

            if root.advertencias.length > 0 : Banner {
                titulo: "Claves que ORDER no conoce (se ignoran):";
                lineas: root.advertencias;
                fondo-color: Tema.fondo-aviso;
                filo: Tema.borde-aviso;
                tinta: Tema.texto-aviso;
            }

            if root.conflicto-texto != "" : BannerConflicto {
                mensaje: root.conflicto-texto;
                quedar-actual => { root.conflicto-quedar-actual(); }
                usar-otra => { root.conflicto-usar-otra(); }
            }

            if root.moodle-banner != "" : Banner {
                titulo: root.moodle-banner;
                lineas: [];
                fondo-color: Tema.fondo-aviso;
                filo: Tema.borde-aviso;
                tinta: Tema.texto-aviso;
            }

            if root.ical-oferta != "" : BannerConflicto {
                mensaje: "¿Agregar este calendario? " + root.ical-oferta;
                texto-principal: "Agregar";
                texto-secundario: "No";
                quedar-actual => { root.ical-oferta-aceptar(); }
                usar-otra => { root.ical-oferta-rechazar(); }
            }

            // --- Contenido ------------------------------------------------
            VerticalLayout {
                vertical-stretch: 1;
                padding: Tema.espacio-lg;
                spacing: 0;

                if root.pestana == 0 : InicioVista {
                    vertical-stretch: 1;
                    fecha-larga: root.inicio-fecha;
                    clases: root.inicio-clases;
                    hay-siguiente: root.inicio-hay-siguiente;
                    siguiente: root.inicio-siguiente;
                    vencidas: root.inicio-vencidas;
                    de-hoy: root.inicio-de-hoy;
                    proximas: root.inicio-proximas;
                    recordatorios: root.inicio-recordatorios;
                    por-materia: root.inicio-por-materia;

                    editar-tarea(id) => { root.editar-tarea(id); }
                    editar-clase(id) => { root.editar-clase(id); }
                    editar-recordatorio(id) => { root.editar-recordatorio(id); }
                }

                if root.pestana == 1 : DiaVista {
                    vertical-stretch: 1;
                    etiqueta: root.dia-etiqueta;
                    es-hoy: root.dia-es-hoy;
                    clases: root.dia-clases;
                    tareas: root.dia-tareas;
                    recordatorios: root.dia-recordatorios;

                    anterior => { root.dia-anterior(); }
                    siguiente => { root.dia-siguiente(); }
                    ir-hoy => { root.dia-hoy(); }
                    editar-tarea(id) => { root.editar-tarea(id); }
                    editar-clase(id) => { root.editar-clase(id); }
                    editar-recordatorio(id) => { root.editar-recordatorio(id); }
                    nueva-clase => { root.nueva-clase(); }
                    nueva-tarea => { root.nueva-tarea(); }
                }

                if root.pestana == 2 : SemanaVista {
                    vertical-stretch: 1;
                    dias: root.dias;
                    etiqueta: root.etiqueta-semana;
                    es-actual: root.es-semana-actual;
                    base: root.base-hora;
                    fin-hora: root.fin-hora;
                    etiquetas-hora: root.etiquetas-hora;
                    mostrar-ahora: root.mostrar-ahora;
                    ahora-min: root.ahora-min;
                    hay-tareas: root.hay-tareas;

                    anterior => { root.semana-anterior(); }
                    siguiente => { root.semana-siguiente(); }
                    ir-hoy => { root.ir-hoy(); }
                    nueva-clase => { root.nueva-clase(); }
                    editar-clase(id) => { root.editar-clase(id); }
                }

                if root.pestana == 3 : PendientesVista {
                    vertical-stretch: 1;
                    tareas: root.tareas;
                    resumen: root.resumen-pendientes;
                    pm-materia: root.pm-materia;
                    pm-fecha: root.pm-fecha;
                    pm-desde: root.pm-desde;
                    pm-hasta: root.pm-hasta;
                    pm-hora-desde: root.pm-hora-desde;
                    pm-hora-hasta: root.pm-hora-hasta;
                    pm-mostrar-hechas: root.pm-mostrar-hechas;
                    pm-filtro-activo: root.pm-filtro-activo;

                    editar(id) => { root.editar-tarea(id); }
                    marcar(id, hecha) => { root.marcar-hecha(id, hecha); }
                    filtro-materia => { root.abrir-materia(21); }
                    filtro-fecha(opcion) => { root.filtro-fecha(opcion); }
                    filtro-hechas(mostrar) => { root.filtro-hechas(mostrar); }
                    filtro-limpiar => { root.filtro-limpiar(); }
                    elegir-desde => { root.abrir-fecha(22); }
                    elegir-hasta => { root.abrir-fecha(23); }
                    elegir-hora-desde => { root.abrir-hora(24); }
                    elegir-hora-hasta => { root.abrir-hora(25); }
                }
            }

            // --- Agente: conexión guiada, respuesta y barra fija ----------
            if root.conexion-abierta : TarjetaConexionAgente {
                titulo: root.conexion-titulo;
                paso-1: root.conexion-paso-1;
                paso-2: root.conexion-paso-2;
                paso-3: root.conexion-paso-3;
                texto-abrir-studio: root.conexion-texto-abrir-studio;
                texto-pegar: root.conexion-texto-pegar;
                etiqueta-clave: root.conexion-etiqueta-clave;
                pista-clave: root.conexion-pista-clave;
                texto-conectar: root.conexion-texto-conectar;
                texto-conectando: root.conexion-texto-conectando;
                texto-otro-proveedor: root.conexion-texto-otro-proveedor;
                clave <=> root.conexion-key;
                ver-clave: root.conexion-ver-key;
                conectando: root.conexion-conectando;
                estado-texto: root.conexion-estado-texto;
                estado-error: root.conexion-estado-error;

                abrir-studio => { root.conexion-abrir-studio(); }
                pegar-clave => { root.conexion-pegar(); }
                alternar-clave => { root.conexion-alternar-clave(); }
                conectar => { root.conexion-conectar(); }
                otro-proveedor => { root.conexion-otro-proveedor(); }
                cerrar => { root.conexion-cerrar(); }
            }

            if !root.conexion-abierta && root.agente-panel : PanelAgente {
                respuesta: root.agente-respuesta;
                acciones: root.agente-acciones;
                nota: root.agente-nota;

                aplicar(indice) => { root.agente-aplicar(indice); }
                descartar(indice) => { root.agente-descartar(indice); }
                aplicar-todas => { root.agente-aplicar-todas(); }
                cerrar => { root.agente-cerrar(); }
            }

            BarraAgente {
                texto <=> root.agente-texto;
                pensando: root.agente-pensando;
                pensando-texto: root.agente-pensando-texto;
                aviso: root.agente-aviso;
                grabando: root.agente-grabando;
                tiempo: root.agente-tiempo;
                adjuntos: root.agente-adjuntos;
                leyendo: root.agente-leyendo;
                hay-conversacion: root.agente-hay-conversacion;
                enviar => { root.agente-enviar(); }
                grabar => { root.grabar-voz(); }
                adjuntar => { root.agente-adjuntar(); }
                quitar-adjunto(id) => { root.agente-quitar-adjunto(id); }
                nueva-conversacion => { root.agente-nueva-conversacion(); }
            }

            // --- Pie ------------------------------------------------------
            Rectangle {
                height: Tema.alto-pie;
                background: Tema.fondo-panel;

                Rectangle {
                    y: 0;
                    width: parent.width;
                    height: Tema.linea;
                    background: Tema.borde;
                }

                Text {
                    x: Tema.espacio-lg;
                    width: parent.width - 2 * Tema.espacio-lg;
                    height: parent.height;
                    vertical-alignment: center;
                    text: root.pie;
                    font-size: Tema.tamano-pie;
                    color: Tema.texto-suave;
                    overflow: elide;
                }
            }
        }

        // -----------------------------------------------------------------
        // Formularios: capa encima de la ventana, con velo que bloquea el
        // fondo para que un clic perdido no cambie de semana o de pestaña.
        // -----------------------------------------------------------------
        if root.formulario != 0 : Rectangle {
            x: 0;
            y: 0;
            width: parent.width;
            height: parent.height;
            background: Tema.fondo-velo;

            TouchArea {
                clicked => { }
            }

            // --- Tarea ----------------------------------------------------
            if root.formulario == 1 : Marco {
                encabezado: root.form-encabezado;
                sub: root.form-edita ? "Los cambios se guardan en order.toml." : "Se agrega al final de order.toml.";
                alto-panel: root.form-edita && root.f-enlace != "" ? Tema.alto-panel-tarea-enlace : Tema.alto-panel-tarea;
                error: root.form-error;
                confirma: root.form-confirma;
                pregunta-confirma: "¿Borrar esta tarea del archivo?";
                puede-borrar: root.form-edita;

                guardar => { root.guardar-formulario(); }
                cancelar => { root.cancelar-formulario(); }
                pedir-borrar => { root.form-confirma = true; }
                confirmar-borrado => { root.confirmar-borrado(); }
                no-borrar => { root.form-confirma = false; }

                VerticalLayout {
                    spacing: Tema.espacio-md;

                    Campo {
                        etiqueta: "Título";
                        texto <=> root.f-titulo;
                        pista: "Taller 2";
                        mal: root.campo-mal == 1;
                    }

                    CampoBoton {
                        etiqueta: "Materia (opcional)";
                        valor: root.f-materia;
                        pista: "Elegir materia";
                        glifo: "▾";
                        clicked => { root.abrir-materia(1); }
                    }

                    HorizontalLayout {
                        spacing: Tema.espacio-md;

                        CampoBoton {
                            horizontal-stretch: 1;
                            etiqueta: "Fecha de entrega";
                            valor: root.f-fecha;
                            pista: "Elegir fecha";
                            glifo: "▦";
                            mal: root.campo-mal == 2;
                            clicked => { root.abrir-fecha(2); }
                        }

                        CampoBoton {
                            width: Tema.ancho-campo-hora;
                            etiqueta: "Hora";
                            valor: root.f-hora;
                            pista: "Elegir hora";
                            glifo: "◷";
                            mal: root.campo-mal == 3;
                            clicked => { root.abrir-hora(3); }
                        }
                    }

                    HorizontalLayout {
                        spacing: Tema.espacio-sm;
                        cross-axis-alignment: center;

                        Casilla {
                            marcada: root.f-hecha;
                            clicked => { root.f-hecha = !root.f-hecha; }
                        }

                        Text {
                            text: "Ya está hecha";
                            font-size: Tema.tamano-pequeno;
                            color: Tema.texto-suave;
                            vertical-alignment: center;
                        }
                    }

                    if root.form-edita && root.f-enlace != "" : Boton {
                        texto: "Abrir en Moodle";
                        width: Tema.ancho-boton-largo;
                        clicked => { root.abrir-enlace-tarea(); }
                    }
                }
            }

            // --- Clase ----------------------------------------------------
            if root.formulario == 2 : Marco {
                encabezado: root.form-encabezado;
                sub: "La clase se repite cada semana dentro del semestre.";
                alto-panel: Tema.alto-panel-clase;
                error: root.form-error;
                confirma: root.form-confirma;
                pregunta-confirma: "¿Borrar esta clase del archivo?";
                puede-borrar: root.form-edita;

                guardar => { root.guardar-formulario(); }
                cancelar => { root.cancelar-formulario(); }
                pedir-borrar => { root.form-confirma = true; }
                confirmar-borrado => { root.confirmar-borrado(); }
                no-borrar => { root.form-confirma = false; }

                VerticalLayout {
                    spacing: Tema.espacio-md;

                    CampoBoton {
                        etiqueta: "Materia";
                        valor: root.f-materia;
                        pista: "Elegir materia";
                        glifo: "▾";
                        mal: root.campo-mal == 1;
                        clicked => { root.abrir-materia(1); }
                    }

                    VerticalLayout {
                        spacing: Tema.espacio-xs;

                        Etiqueta {
                            text: "Días (uno o varios)";
                            mal: root.campo-mal == 4;
                        }

                        HorizontalLayout {
                            spacing: Tema.espacio-xs;

                            Chip { texto: "Lun"; activo: root.f-lun; clicked => { root.f-lun = !root.f-lun; } }
                            Chip { texto: "Mar"; activo: root.f-mar; clicked => { root.f-mar = !root.f-mar; } }
                            Chip { texto: "Mié"; activo: root.f-mie; clicked => { root.f-mie = !root.f-mie; } }
                            Chip { texto: "Jue"; activo: root.f-jue; clicked => { root.f-jue = !root.f-jue; } }
                            Chip { texto: "Vie"; activo: root.f-vie; clicked => { root.f-vie = !root.f-vie; } }
                            Chip { texto: "Sáb"; activo: root.f-sab; clicked => { root.f-sab = !root.f-sab; } }
                            Chip { texto: "Dom"; activo: root.f-dom; clicked => { root.f-dom = !root.f-dom; } }
                        }
                    }

                    HorizontalLayout {
                        spacing: Tema.espacio-md;

                        CampoBoton {
                            horizontal-stretch: 1;
                            etiqueta: "Inicio";
                            valor: root.f-hora;
                            pista: "Elegir hora";
                            glifo: "◷";
                            mal: root.campo-mal == 2;
                            clicked => { root.abrir-hora(2); }
                        }

                        CampoBoton {
                            horizontal-stretch: 1;
                            etiqueta: "Fin";
                            valor: root.f-fin;
                            pista: "Elegir hora";
                            glifo: "◷";
                            mal: root.campo-mal == 3;
                            clicked => { root.abrir-hora(3); }
                        }
                    }

                    Campo {
                        etiqueta: "Lugar (opcional)";
                        texto <=> root.f-lugar;
                        pista: "453-201";
                    }
                }
            }

            // --- Ajustes --------------------------------------------------
            if root.formulario == 3 : Marco {
                encabezado: "Ajustes";
                sub: "Semestre, avisos y recordatorios fijos.";
                alto-panel: Tema.alto-panel-ajustes;
                ancho-panel: Tema.ancho-formulario-ancho;
                error: root.form-error;
                confirma: false;
                puede-borrar: false;
                estirar-contenido: true;

                guardar => { root.guardar-formulario(); }
                cancelar => { root.cancelar-formulario(); }
                pedir-borrar => { }
                confirmar-borrado => { }
                no-borrar => { }

                VerticalLayout {
                    vertical-stretch: 1;
                    spacing: Tema.espacio-md;

                    HorizontalLayout {
                        spacing: Tema.espacio-sm;
                        cross-axis-alignment: center;

                        Casilla {
                            marcada: root.a-sin-semestre;
                            clicked => { root.a-sin-semestre = !root.a-sin-semestre; }
                        }

                        Text {
                            text: "Sin semestre (las clases valen todo el año)";
                            font-size: Tema.tamano-pequeno;
                            color: Tema.texto-suave;
                            vertical-alignment: center;
                        }
                    }

                    HorizontalLayout {
                        spacing: Tema.espacio-sm;
                        cross-axis-alignment: center;

                        Casilla {
                            marcada: root.a-autostart;
                            clicked => { root.a-autostart = !root.a-autostart; }
                        }

                        Text {
                            text: "Abrir ORDER al iniciar sesión";
                            font-size: Tema.tamano-pequeno;
                            color: Tema.texto-suave;
                            vertical-alignment: center;
                        }
                    }

                    HorizontalLayout {
                        spacing: Tema.espacio-md;

                        CampoBoton {
                            horizontal-stretch: 1;
                            etiqueta: "Inicio del semestre";
                            valor: root.a-inicio;
                            pista: "Elegir fecha";
                            glifo: "▦";
                            mal: root.campo-mal == 1;
                            apagado: root.a-sin-semestre;
                            clicked => { root.abrir-fecha(1); }
                        }

                        CampoBoton {
                            horizontal-stretch: 1;
                            etiqueta: "Fin del semestre";
                            valor: root.a-fin;
                            pista: "Elegir fecha";
                            glifo: "▦";
                            mal: root.campo-mal == 2;
                            apagado: root.a-sin-semestre;
                            clicked => { root.abrir-fecha(2); }
                        }
                    }

                    HorizontalLayout {
                        spacing: Tema.espacio-md;

                        CampoBoton {
                            horizontal-stretch: 1;
                            etiqueta: "Aviso del día antes";
                            valor: root.a-hora;
                            pista: "Elegir hora";
                            glifo: "◷";
                            mal: root.campo-mal == 3;
                            clicked => { root.abrir-hora(3); }
                        }

                        Campo {
                            horizontal-stretch: 1;
                            etiqueta: "Horas antes de vencer";
                            texto <=> root.a-horas;
                            pista: "3";
                            mal: root.campo-mal == 4;
                        }
                    }

                    Etiqueta {
                        text: "RECORDATORIOS";
                    }

                    ScrollView {
                        vertical-stretch: 1;
                        min-height: Tema.alto-lista-recordatorios;

                        VerticalLayout {
                            spacing: 0;

                            for recordatorio in root.recordatorios : Rectangle {
                                height: Tema.alto-fila-compacta;
                                background: fila-ta.has-hover ? Tema.fondo-hover : transparent;

                                fila-ta := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.editar-recordatorio(recordatorio.id); }
                                }

                                HorizontalLayout {
                                    width: parent.width;
                                    height: parent.height;
                                    padding-left: Tema.espacio-sm;
                                    padding-right: Tema.espacio-sm;
                                    spacing: Tema.espacio-md;
                                    cross-axis-alignment: center;

                                    Text {
                                        horizontal-stretch: 1;
                                        text: recordatorio.texto;
                                        font-size: Tema.tamano-pequeno;
                                        color: Tema.texto;
                                        overflow: elide;
                                    }

                                    Text {
                                        text: recordatorio.dias + " · " + recordatorio.hora;
                                        font-size: Tema.tamano-hora;
                                        color: Tema.texto-suave;
                                        overflow: elide;
                                    }
                                }

                                Rectangle {
                                    y: parent.height - Tema.linea;
                                    width: parent.width;
                                    height: Tema.linea;
                                    background: Tema.borde-suave;
                                }
                            }

                            if root.recordatorios.length == 0 : Text {
                                height: Tema.alto-fila-compacta;
                                vertical-alignment: center;
                                text: "Sin recordatorios.";
                                font-size: Tema.tamano-pequeno;
                                color: Tema.texto-tenue;
                            }
                        }
                    }

                    HorizontalLayout {
                        spacing: Tema.espacio-sm;

                        Boton {
                            texto: "Agregar recordatorio";
                            width: Tema.ancho-boton-largo;
                            clicked => { root.nuevo-recordatorio(); }
                        }
                    }

                    HorizontalLayout {
                        spacing: Tema.espacio-sm;

                        Boton {
                            texto: "Agente…";
                            width: Tema.ancho-boton-clase;
                            clicked => { root.abrir-agente(); }
                        }

                        Boton {
                            texto: root.moodle-requiere-reingreso ? "Moodle !" : "Moodle…";
                            width: Tema.ancho-boton-clase;
                            clicked => { root.abrir-moodle(); }
                        }

                        Boton {
                            texto: "Calendarios…";
                            width: Tema.ancho-boton-tarea;
                            clicked => { root.abrir-calendarios(); }
                        }

                        Boton {
                            texto: "Dispositivos…";
                            width: Tema.ancho-boton-dispositivos;
                            clicked => { root.abrir-dispositivos(); }
                        }
                    }
                }
            }

            // --- Recordatorio ---------------------------------------------
            if root.formulario == 4 : Marco {
                encabezado: root.form-encabezado;
                sub: "Se avisa a esa hora los días marcados.";
                alto-panel: Tema.alto-panel-recordatorio;
                error: root.form-error;
                confirma: root.form-confirma;
                pregunta-confirma: "¿Borrar este recordatorio del archivo?";
                puede-borrar: root.form-edita;

                guardar => { root.guardar-formulario(); }
                cancelar => { root.cancelar-formulario(); }
                pedir-borrar => { root.form-confirma = true; }
                confirmar-borrado => { root.confirmar-borrado(); }
                no-borrar => { root.form-confirma = false; }

                VerticalLayout {
                    spacing: Tema.espacio-md;

                    Campo {
                        etiqueta: "Texto";
                        texto <=> root.r-texto;
                        pista: "Revisar Moodle";
                        mal: root.campo-mal == 1;
                    }

                    VerticalLayout {
                        spacing: Tema.espacio-xs;

                        Etiqueta {
                            text: "Días";
                            mal: root.campo-mal == 4;
                        }

                        HorizontalLayout {
                            spacing: Tema.espacio-xs;

                            Chip { texto: "Lun"; activo: root.r-lun; clicked => { root.r-lun = !root.r-lun; } }
                            Chip { texto: "Mar"; activo: root.r-mar; clicked => { root.r-mar = !root.r-mar; } }
                            Chip { texto: "Mié"; activo: root.r-mie; clicked => { root.r-mie = !root.r-mie; } }
                            Chip { texto: "Jue"; activo: root.r-jue; clicked => { root.r-jue = !root.r-jue; } }
                            Chip { texto: "Vie"; activo: root.r-vie; clicked => { root.r-vie = !root.r-vie; } }
                            Chip { texto: "Sáb"; activo: root.r-sab; clicked => { root.r-sab = !root.r-sab; } }
                            Chip { texto: "Dom"; activo: root.r-dom; clicked => { root.r-dom = !root.r-dom; } }
                        }
                    }

                    CampoBoton {
                        width: Tema.ancho-campo-hora;
                        etiqueta: "Hora";
                        valor: root.r-hora;
                        pista: "Elegir hora";
                        glifo: "◷";
                        mal: root.campo-mal == 2;
                        clicked => { root.abrir-hora(2); }
                    }
                }
            }
            // --- Agente ---------------------------------------------------
            if root.formulario == 5 : Marco {
                encabezado: "Agente";
                sub: "Responde en la barra de abajo. La clave vive en agente.toml (permisos 600).";
                alto-panel: Tema.alto-panel-agente-config;
                ancho-panel: Tema.ancho-formulario-ancho;
                error: root.form-error;
                confirma: false;
                puede-borrar: false;
                estirar-contenido: true;

                guardar => { root.guardar-formulario(); }
                cancelar => { root.cancelar-formulario(); }
                pedir-borrar => { }
                confirmar-borrado => { }
                no-borrar => { }

                ScrollView {
                    vertical-stretch: 1;
                    min-height: 0px;

                    VerticalLayout {
                        spacing: Tema.espacio-md;

                        VerticalLayout {
                            spacing: Tema.espacio-xs;

                            Etiqueta {
                                text: "Proveedor";
                            }

                            HorizontalLayout {
                                spacing: Tema.espacio-xs;

                                Chip {
                                    texto: "Gemini · Gratis";
                                    ancho: Tema.ancho-ficha-gemini;
                                    activo: root.a-proveedor == 0;
                                    clicked => { root.elegir-proveedor(0); }
                                }

                                Chip {
                                    texto: "DeepSeek";
                                    ancho: Tema.ancho-ficha-proveedor;
                                    activo: root.a-proveedor == 1;
                                    clicked => { root.elegir-proveedor(1); }
                                }

                                Chip {
                                    texto: "Claude";
                                    ancho: Tema.ancho-ficha-proveedor;
                                    activo: root.a-proveedor == 2;
                                    clicked => { root.elegir-proveedor(2); }
                                }

                                Chip {
                                    texto: "Otro";
                                    ancho: Tema.ancho-ficha-proveedor;
                                    activo: root.a-proveedor == 3;
                                    clicked => { root.elegir-proveedor(3); }
                                }
                            }
                        }

                        // "Otro" no tiene página de claves: no hay proveedor detrás.
                        if root.a-proveedor != 3 : Boton {
                            texto: "Conseguir mi API key";
                            width: Tema.ancho-boton-largo;
                            clicked => { root.conseguir-clave(root.a-proveedor); }
                        }

                        CampoClave {
                            etiqueta: "API key";
                            texto <=> root.a-key;
                            pista: root.a-proveedor == 0 ? "AIza…" : "sk-…";
                            ver: root.a-ver-key;
                            mal: root.campo-mal == 5;
                            alternar => { root.alternar-clave(); }
                        }

                        Text {
                            text: "Pega aquí la clave que te da el proveedor.";
                            wrap: word-wrap;
                            font-size: Tema.tamano-hora;
                            color: Tema.texto-tenue;
                        }

                        Rectangle {
                            height: Tema.linea;
                            background: Tema.borde-suave;
                        }

                        VerticalLayout {
                            spacing: Tema.espacio-xs;

                            Etiqueta {
                                text: "Voz";
                            }

                            HorizontalLayout {
                                spacing: Tema.espacio-xs;

                                Chip {
                                    texto: "Este PC (gratis)";
                                    ancho: Tema.ancho-ficha-voz-local;
                                    activo: root.a-voz-proveedor == 2;
                                    clicked => { root.elegir-voz-proveedor(2); }
                                }

                                Chip {
                                    texto: "OpenAI";
                                    ancho: Tema.ancho-ficha-proveedor;
                                    activo: root.a-voz-proveedor == 0;
                                    clicked => { root.elegir-voz-proveedor(0); }
                                }

                                Chip {
                                    texto: "Groq";
                                    ancho: Tema.ancho-ficha-proveedor;
                                    activo: root.a-voz-proveedor == 1;
                                    clicked => { root.elegir-voz-proveedor(1); }
                                }
                            }
                        }

                        if root.a-voz-proveedor == 2 : VerticalLayout {
                            spacing: Tema.espacio-xs;

                            Text {
                                text: "Transcribe en tu equipo (whisper.cpp, idioma español), sin clave ni costo.";
                                wrap: word-wrap;
                                font-size: Tema.tamano-hora;
                                color: Tema.texto-tenue;
                            }

                            HorizontalLayout {
                                spacing: Tema.espacio-sm;
                                cross-axis-alignment: center;

                                Text {
                                    horizontal-stretch: 1;
                                    text: root.a-voz-modelo-listo
                                        ? "Modelo listo (~/.local/share/order/modelos/ggml-small.bin)."
                                        : "Falta el modelo de voz (~470 MB).";
                                    wrap: word-wrap;
                                    font-size: Tema.tamano-hora;
                                    color: root.a-voz-modelo-listo ? Tema.texto-suave : Tema.texto-aviso;
                                }

                                if !root.a-voz-modelo-listo : Boton {
                                    texto: "Descargar modelo";
                                    width: Tema.ancho-boton-largo;
                                    clicked => { root.descarga-voz-abrir(); }
                                }
                            }
                        }

                        if root.a-voz-proveedor != 2 : Boton {
                            texto: "Conseguir mi API key";
                            width: Tema.ancho-boton-largo;
                            clicked => { root.conseguir-clave-voz(root.a-voz-proveedor); }
                        }

                        if root.a-voz-proveedor != 2 : CampoClave {
                            etiqueta: "API key";
                            texto <=> root.v-key;
                            pista: root.a-voz-proveedor == 1 ? "gsk_…" : "sk-…";
                            ver: root.v-ver-key;
                            alternar => { root.alternar-clave-voz(); }
                        }

                        if root.a-voz-proveedor != 2 : Text {
                            text: "Pega aquí la clave que te da el proveedor.";
                            wrap: word-wrap;
                            font-size: Tema.tamano-hora;
                            color: Tema.texto-tenue;
                        }

                        Rectangle {
                            height: Tema.linea;
                            background: Tema.borde-suave;
                        }

                        Boton {
                            texto: root.a-avanzado || root.a-proveedor == 3 ? "Avanzado ▾" : "Avanzado ▸";
                            width: Tema.ancho-boton-avanzado;
                            clicked => { root.alternar-avanzado(); }
                        }

                        // Con "Otro" se abre sola: ahí sí hacen falta los campos.
                        if root.a-avanzado || root.a-proveedor == 3 : VerticalLayout {
                            spacing: Tema.espacio-md;

                            Text {
                                text: "URL base y modelo, para escribirlos a mano.";
                                wrap: word-wrap;
                                font-size: Tema.tamano-hora;
                                color: Tema.texto-tenue;
                            }

                            Campo {
                                etiqueta: "URL base del agente";
                                texto <=> root.a-url;
                                pista: "https://…";
                                mal: root.campo-mal == 1;
                            }

                            Campo {
                                etiqueta: "Modelo del agente";
                                texto <=> root.a-modelo;
                                pista: "modelo";
                                mal: root.campo-mal == 2;
                            }

                            if root.a-voz-proveedor != 2 : Campo {
                                etiqueta: "URL base de la voz";
                                texto <=> root.v-url;
                                pista: "https://…";
                                mal: root.campo-mal == 3;
                            }

                            if root.a-voz-proveedor != 2 : Campo {
                                etiqueta: "Modelo de la voz";
                                texto <=> root.v-modelo;
                                pista: "modelo";
                                mal: root.campo-mal == 4;
                            }

                            Campo {
                                etiqueta: "Límite de contexto (tokens)";
                                texto <=> root.a-limite-contexto;
                                pista: "60000";
                                mal: root.campo-mal == 6;
                            }

                            if root.a-proveedor == 3 : HorizontalLayout {
                                spacing: Tema.espacio-sm;
                                cross-axis-alignment: center;

                                Casilla {
                                    marcada: root.a-ve-imagenes;
                                    clicked => { root.a-ve-imagenes = !root.a-ve-imagenes; }
                                }

                                Text {
                                    text: "El modelo ve imágenes";
                                    font-size: Tema.tamano-pequeno;
                                    color: Tema.texto-suave;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }
            }

            // --- Moodle ---------------------------------------------------
            if root.formulario == 6 : Marco {
                encabezado: "Moodle";
                sub: "Sincroniza entregas automáticamente. Solo guarda el token.";
                alto-panel: Tema.alto-panel-moodle;
                ancho-panel: Tema.ancho-formulario-ancho;
                error: root.form-error;
                confirma: false;
                puede-borrar: false;
                estirar-contenido: true;
                texto-cancelar: "Volver";
                texto-guardar: (!root.moodle-conectado || root.moodle-requiere-reingreso)
                    ? (root.moodle-ocupado ? "Conectando…" : "Conectar")
                    : (root.moodle-ocupado ? "Sincronizando…" : "Sincronizar ahora");
                mostrar-guardar: !root.moodle-ocupado;

                guardar => {
                    if !root.moodle-conectado || root.moodle-requiere-reingreso {
                        root.moodle-conectar();
                    } else {
                        root.moodle-sincronizar();
                    }
                }
                cancelar => { root.cancelar-formulario(); }
                pedir-borrar => { }
                confirmar-borrado => { }
                no-borrar => { }

                ScrollView {
                    vertical-stretch: 1;
                    min-height: 0px;

                    VerticalLayout {
                        spacing: Tema.espacio-md;

                    if root.moodle-conectado : Text {
                        text: root.moodle-estado-texto;
                        wrap: word-wrap;
                        font-size: Tema.tamano-pequeno;
                        color: root.moodle-requiere-reingreso ? Tema.texto-aviso : Tema.texto;
                    }

                    if !root.moodle-conectado || root.moodle-requiere-reingreso : VerticalLayout {
                        spacing: Tema.espacio-md;

                        Campo {
                            etiqueta: "Sitio de Moodle";
                            texto <=> root.m-sitio;
                            pista: "micampus.unal.edu.co";
                            apagado: root.moodle-ocupado;
                        }

                        Campo {
                            etiqueta: "Usuario";
                            texto <=> root.m-usuario;
                            pista: "usuario";
                            apagado: root.moodle-ocupado;
                        }

                        CampoClave {
                            etiqueta: "Contraseña";
                            texto <=> root.m-contrasena;
                            pista: "••••••••";
                            ver: root.m-ver-pass;
                            alternar => { root.m-ver-pass = !root.m-ver-pass; }
                        }
                    }

                    if root.moodle-aviso != "" : Text {
                        text: root.moodle-aviso;
                        wrap: word-wrap;
                        font-size: Tema.tamano-pequeno;
                        color: Tema.texto-suave;
                    }

                    if root.moodle-conectado : HorizontalLayout {
                        spacing: Tema.espacio-sm;

                        Boton {
                            texto: "Desconectar";
                            peligro: true;
                            width: Tema.ancho-boton-form;
                            clicked => { root.moodle-desconectar(); }
                        }
                    }
                }
                }
            }

            // --- Calendarios iCal -----------------------------------------
            if root.formulario == 7 : Marco {
                encabezado: "Calendarios";
                sub: "Eventos iCal (.ics / webcal://) como tareas.";
                alto-panel: Tema.alto-panel-calendarios;
                ancho-panel: Tema.ancho-formulario-ancho;
                error: root.form-error;
                confirma: false;
                puede-borrar: false;
                estirar-contenido: true;
                texto-cancelar: "Volver";
                texto-guardar: root.ical-ocupado ? "Agregando…" : "Agregar calendario";
                mostrar-guardar: !root.ical-ocupado;

                guardar => { root.ical-agregar(); }
                cancelar => { root.cancelar-formulario(); }
                pedir-borrar => { }
                confirmar-borrado => { }
                no-borrar => { }

                VerticalLayout {
                    vertical-stretch: 1;
                    spacing: Tema.espacio-sm;

                    ScrollView {
                        vertical-stretch: 1;
                        min-height: Tema.alto-lista-calendarios;

                        VerticalLayout {
                            spacing: 0;

                            for cal in root.calendarios : Rectangle {
                                height: Tema.alto-fila-compacta;

                                HorizontalLayout {
                                    width: parent.width;
                                    height: parent.height;
                                    padding-left: Tema.espacio-xs;
                                    padding-right: Tema.espacio-xs;
                                    spacing: Tema.espacio-sm;
                                    cross-axis-alignment: center;

                                    Text {
                                        horizontal-stretch: 1;
                                        text: cal.materia == "" ? cal.nombre : cal.nombre + " (" + cal.materia + ")";
                                        font-size: Tema.tamano-pequeno;
                                        color: cal.materia == "" ? Tema.texto : Tema.materias[cal.tono];
                                        overflow: elide;
                                    }

                                    Text {
                                        text: cal.ultima;
                                        font-size: Tema.tamano-hora;
                                        color: Tema.texto-suave;
                                        overflow: elide;
                                    }

                                    Boton {
                                        texto: "Quitar";
                                        peligro: true;
                                        width: Tema.ancho-boton-cerrar;
                                        clicked => { root.ical-quitar(cal.id); }
                                    }
                                }

                                Rectangle {
                                    y: parent.height - Tema.linea;
                                    width: parent.width;
                                    height: Tema.linea;
                                    background: Tema.borde-suave;
                                }
                            }

                            if root.calendarios.length == 0 : Text {
                                height: Tema.alto-fila-compacta;
                                vertical-alignment: center;
                                text: "Sin calendarios agregados.";
                                font-size: Tema.tamano-pequeno;
                                color: Tema.texto-tenue;
                            }
                        }
                    }

                    Campo {
                        etiqueta: "Dirección iCal (.ics o webcal://)";
                        texto <=> root.c-url;
                        pista: "https://calendar.google.com/calendar/ical/…/basic.ics";
                        apagado: root.ical-ocupado;
                    }

                    HorizontalLayout {
                        spacing: Tema.espacio-md;

                        Campo {
                            horizontal-stretch: 1;
                            etiqueta: "Nombre (opcional)";
                            texto <=> root.c-nombre;
                            pista: "Universidad";
                            apagado: root.ical-ocupado;
                        }

                        CampoBoton {
                            horizontal-stretch: 1;
                            etiqueta: "Materia (opcional)";
                            valor: root.c-materia;
                            pista: "Automática";
                            glifo: "▾";
                            apagado: root.ical-ocupado;
                            clicked => { root.abrir-materia(4); }
                        }
                    }

                    HorizontalLayout {
                        spacing: Tema.espacio-sm;
                        cross-axis-alignment: center;

                        Boton {
                            texto: root.ical-ocupado ? "Sincronizando…" : "Sincronizar ahora";
                            width: Tema.ancho-boton-largo;
                            clicked => {
                                if !root.ical-ocupado {
                                    root.ical-sincronizar();
                                }
                            }
                        }

                        Text {
                            horizontal-stretch: 1;
                            text: root.ical-aviso;
                            font-size: Tema.tamano-hora;
                            color: Tema.texto-suave;
                            overflow: elide;
                        }
                    }
                }
            }

            // --- Dispositivos (sincronización P2P) ------------------------
            if root.formulario == 8 : Marco {
                encabezado: "Dispositivos";
                sub: "Sincroniza tu agenda entre PC y celular sin cuentas ni servidores.";
                alto-panel: Tema.alto-panel-dispositivos;
                ancho-panel: Tema.ancho-formulario-ancho;
                error: root.form-error;
                confirma: false;
                puede-borrar: false;
                estirar-contenido: true;
                texto-cancelar: "Volver";
                texto-guardar: root.p2p-ocupado ? "Sincronizando…" : "Sincronizar ahora";
                mostrar-guardar: !root.p2p-ocupado && !root.p2p-mostrando-qr;

                guardar => { root.p2p-sincronizar(); }
                cancelar => { root.cancelar-formulario(); }
                pedir-borrar => { }
                confirmar-borrado => { }
                no-borrar => { }

                ScrollView {
                    vertical-stretch: 1;
                    min-height: 0px;

                    VerticalLayout {
                        spacing: Tema.espacio-md;

                        HorizontalLayout {
                            spacing: Tema.espacio-sm;
                            cross-axis-alignment: end;

                            Campo {
                                horizontal-stretch: 1;
                                etiqueta: "Este dispositivo";
                                texto <=> root.p2p-nombre;
                                pista: "Computador";
                            }

                            Boton {
                                texto: "Guardar";
                                width: Tema.ancho-boton-form;
                                clicked => { root.p2p-guardar-nombre(); }
                            }
                        }

                        if !root.p2p-mostrando-qr : VerticalLayout {
                            spacing: Tema.espacio-md;

                            Etiqueta {
                                text: "EMPAREJADOS";
                            }

                            ScrollView {
                                height: Tema.alto-lista-dispositivos;

                                VerticalLayout {
                                    spacing: 0;

                                    for disp in root.p2p-dispositivos : Rectangle {
                                        height: Tema.alto-fila-compacta;

                                        HorizontalLayout {
                                            width: parent.width;
                                            height: parent.height;
                                            padding-left: Tema.espacio-xs;
                                            padding-right: Tema.espacio-xs;
                                            spacing: Tema.espacio-sm;
                                            cross-axis-alignment: center;

                                            Text {
                                                horizontal-stretch: 1;
                                                text: disp.nombre;
                                                font-size: Tema.tamano-pequeno;
                                                color: Tema.texto;
                                                overflow: elide;
                                            }

                                            Text {
                                                text: disp.estado;
                                                font-size: Tema.tamano-hora;
                                                color: disp.en-linea ? Tema.texto-suave : Tema.vencida-texto;
                                                overflow: elide;
                                            }

                                            Boton {
                                                texto: "Quitar";
                                                peligro: true;
                                                width: Tema.ancho-boton-cerrar;
                                                clicked => { root.p2p-quitar(disp.id); }
                                            }
                                        }

                                        Rectangle {
                                            y: parent.height - Tema.linea;
                                            width: parent.width;
                                            height: Tema.linea;
                                            background: Tema.borde-suave;
                                        }
                                    }

                                    if root.p2p-dispositivos.length == 0 : Text {
                                        height: Tema.alto-fila-compacta;
                                        vertical-alignment: center;
                                        text: "Sin dispositivos emparejados.";
                                        font-size: Tema.tamano-pequeno;
                                        color: Tema.texto-tenue;
                                    }
                                }
                            }

                            HorizontalLayout {
                                spacing: Tema.espacio-sm;

                                Boton {
                                    texto: "Agregar dispositivo";
                                    principal: true;
                                    width: Tema.ancho-boton-largo;
                                    clicked => { root.p2p-generar-codigo(); }
                                }
                            }

                            HorizontalLayout {
                                spacing: Tema.espacio-sm;
                                cross-axis-alignment: end;

                                Campo {
                                    horizontal-stretch: 1;
                                    etiqueta: "O escribe un código de 8 palabras / enlace";
                                    texto <=> root.p2p-codigo-entrada;
                                    pista: "order://emparejar?… o 8 palabras";
                                    apagado: root.p2p-ocupado;
                                }

                                Boton {
                                    texto: "Emparejar";
                                    width: Tema.ancho-boton-form;
                                    clicked => {
                                        if !root.p2p-ocupado {
                                            root.p2p-emparejar();
                                        }
                                    }
                                }
                            }
                        }

                        if root.p2p-mostrando-qr : VerticalLayout {
                            spacing: Tema.espacio-sm;

                            Text {
                                text: "Escanea este código desde ORDER en tu celular:";
                                font-size: Tema.tamano-pequeno;
                                color: Tema.texto-suave;
                                wrap: word-wrap;
                            }

                            HorizontalLayout {
                                alignment: center;
                                Image {
                                    source: root.p2p-qr-imagen;
                                    width: Tema.tamano-qr;
                                    height: Tema.tamano-qr;
                                    image-rendering: pixelated;
                                }
                            }

                            Text {
                                text: "Código (en la misma Wi-Fi): " + root.p2p-palabras;
                                font-size: Tema.tamano-pequeno;
                                color: Tema.acento;
                                horizontal-alignment: center;
                                wrap: word-wrap;
                            }

                            Text {
                                text: "Esperando conexión… (válido 10 min)";
                                font-size: Tema.tamano-hora;
                                color: Tema.texto-tenue;
                                horizontal-alignment: center;
                            }

                            HorizontalLayout {
                                alignment: center;
                                spacing: Tema.espacio-sm;

                                Boton {
                                    texto: "Copiar enlace";
                                    width: Tema.ancho-boton-largo;
                                    clicked => { root.p2p-copiar-enlace(); }
                                }

                                Boton {
                                    texto: "Listo";
                                    width: Tema.ancho-boton-form;
                                    clicked => { root.p2p-cerrar-codigo(); }
                                }
                            }
                        }

                        if root.p2p-aviso != "" : Text {
                            text: root.p2p-aviso;
                            wrap: word-wrap;
                            font-size: Tema.tamano-pequeno;
                            color: Tema.texto-suave;
                        }
                    }
                }
            }
        }

        // -----------------------------------------------------------------
        // Selector encima de todo: calendario, horas o materias.
        // -----------------------------------------------------------------
        if root.selector-tipo != 0 : Selector {
            tipo: root.selector-tipo;
            titulo: root.sel-titulo;
            etiqueta-mes: root.sel-mes-texto;
            celdas: root.sel-celdas;
            hora-texto: root.sel-hora-texto;
            hora-inicial: root.sel-hora12;
            minuto-inicial: root.sel-minuto;
            tarde: root.sel-tarde;
            horas: root.sel-horas;
            minutos: root.sel-minutos;
            materias: root.sel-materias;
            materia-nueva <=> root.materia-nueva;
            escribiendo <=> root.materia-escribiendo;

            cerrar => { root.selector-cerrar(); }
            mes(delta) => { root.selector-mes(delta); }
            dia(valor) => { root.selector-dia(valor); }
            hora12(valor) => { root.selector-hora12(valor); }
            minuto(valor) => { root.selector-minuto(valor); }
            periodo(tarde) => { root.selector-pm(tarde); }
            aceptar => { root.selector-aceptar(); }
            escribir => { root.selector-escribir(); }
            materia(valor) => { root.selector-materia(valor); }
        }

        // -----------------------------------------------------------------
        // Descarga del modelo de voz local (~470 MB).
        // -----------------------------------------------------------------
        if root.descarga-voz-abierta : Rectangle {
            x: 0;
            y: 0;
            width: parent.width;
            height: parent.height;
            background: Tema.fondo-velo;

            TouchArea {
                clicked => { }
            }

            Rectangle {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: Tema.ancho-dialogo-descarga;
                height: Tema.alto-dialogo-descarga;
                background: Tema.fondo-panel;
                border-radius: Tema.radio;
                border-width: Tema.linea;
                border-color: Tema.borde-fuerte;

                VerticalLayout {
                    x: Tema.espacio-lg;
                    y: Tema.espacio-lg;
                    width: parent.width - 2 * Tema.espacio-lg;
                    height: parent.height - 2 * Tema.espacio-lg;
                    spacing: Tema.espacio-md;

                    VerticalLayout {
                        spacing: Tema.espacio-xs;

                        Text {
                            text: "Descargar modelo de voz (≈470 MB)";
                            font-family: Tema.fuente-titulos;
                            font-size: Tema.tamano-semana;
                            font-weight: 700;
                            letter-spacing: Tema.letra-normal;
                            color: Tema.texto;
                            overflow: elide;
                        }

                        Text {
                            text: "Se guarda en ~/.local/share/order/modelos/ggml-small.bin para transcribir en local en español.";
                            font-size: Tema.tamano-hora;
                            color: Tema.texto-tenue;
                            wrap: word-wrap;
                        }
                    }

                    if root.descarga-voz-error != "" : Rectangle {
                        height: Tema.alto-campo;
                        border-radius: Tema.radio-pequeno;
                        background: Tema.fondo-error;
                        border-width: Tema.linea;
                        border-color: Tema.borde-error;

                        Text {
                            x: Tema.espacio-sm;
                            width: parent.width - 2 * Tema.espacio-sm;
                            height: parent.height;
                            vertical-alignment: center;
                            text: root.descarga-voz-error;
                            font-size: Tema.tamano-pequeno;
                            color: Tema.texto-error;
                            overflow: elide;
                        }
                    }

                    VerticalLayout {
                        spacing: Tema.espacio-xs;

                        Rectangle {
                            height: Tema.alto-barra-progreso;
                            border-radius: Tema.radio-pequeno;
                            background: Tema.fondo-campo;
                            border-width: Tema.linea;
                            border-color: Tema.borde-campo;
                            clip: true;

                            Rectangle {
                                x: 0;
                                y: 0;
                                width: parent.width * clamp(root.descarga-voz-progreso, 0, 1);
                                height: parent.height;
                                background: Tema.acento;
                            }
                        }

                        if root.descarga-voz-estado != "" : Text {
                            text: root.descarga-voz-estado;
                            font-size: Tema.tamano-hora;
                            color: Tema.texto-suave;
                            overflow: elide;
                        }
                    }

                    Rectangle { vertical-stretch: 1; }

                    HorizontalLayout {
                        alignment: end;
                        spacing: Tema.espacio-sm;

                        Boton {
                            texto: "Cancelar";
                            clicked => { root.descarga-voz-cancelar(); }
                        }

                        if !root.descarga-voz-en-curso : Boton {
                            texto: root.descarga-voz-error != "" ? "Reintentar" : "Descargar";
                            principal: true;
                            clicked => { root.descarga-voz-iniciar(); }
                        }
                    }
                }
            }
        }
    }
}
