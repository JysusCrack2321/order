// Selectores propios de ORDER: fecha (calendario), hora (listas) y materia
// (lista de las ya usadas + escribir una nueva).
// ---------------------------------------------------------------------------
// Se dibujan encima de la ventana, con el mismo tema que el resto: la lógica
// del calendario y de las materias vive en puente.rs; aquí solo se presenta.
// Nada de valores de color o tamaño escritos a mano: todo sale de tema.slint.

import { Tema } from "tema.slint";
import { Boton, Campo, Chip } from "formularios.slint";
import { FichaMateria } from "materias.slint";
import { ScrollView } from "std-widgets.slint";

/// Una casilla del calendario. `dia` en 0 es un hueco antes o después del mes.
export struct CeldaDia {
    dia: int,
    fila: int,
    columna: int,
    hoy: bool,
    elegida: bool,
}

/// Una materia del selector: su nombre y el tono que le toca.
export struct MateriaUI {
    nombre: string,
    tono: int,
}

/// Una rueda de valores: se mueve con la rueda del ratón y arrastrando, y el
/// valor que queda en el centro es el elegido. La banda central lo resalta.
component Rueda inherits Rectangle {
    in property <[string]> valores;
    /// Índice con el que abre la rueda; después manda lo que haga el usuario.
    in property <int> inicial: 0;

    callback elegido(int);

    height: Tema.alto-rueda;
    clip: true;

    // Todo se calcula con números sueltos (sin unidad) y se vuelve a px al
    // final: así las cuentas de la rueda son simples divisiones.
    property <float> renglon: Tema.alto-rueda-item / 1px;
    property <float> alto: self.height / 1px;
    // Posición continua dentro de la lista: 0 = primer valor en el centro.
    property <float> posicion: root.inicial;
    // Posición al empezar a arrastrar y dónde se pulsó.
    property <float> desde: 0;
    property <float> y-pulsada: 0;
    property <int> centro: Math.round(root.posicion);
    property <int> avisado: -1;

    function acotar() {
        if root.posicion < 0 {
            root.posicion = 0;
        }
        if root.posicion > (root.valores.length - 1) * 1.0 {
            root.posicion = (root.valores.length - 1) * 1.0;
        }
        if root.centro != root.avisado {
            root.avisado = root.centro;
            root.elegido(root.centro);
        }
    }

    function soltar() {
        // Un clic sin arrastre elige el renglón que quedó bajo el cursor.
        if Math.abs(root.y-pulsada - root.y-ultima) < Tema.espacio-md / 1px {
            root.posicion = root.posicion + (root.y-ultima - root.alto / 2) / root.renglon;
        }
        root.posicion = Math.round(root.posicion) * 1.0;
        root.acotar();
    }

    // Dónde está el cursor ahora (en números sueltos).
    property <float> y-ultima: 0;

    // Banda central: el valor elegido.
    Rectangle {
        y: (parent.height - Tema.alto-rueda-item) / 2;
        width: parent.width;
        height: Tema.alto-rueda-item;
        border-radius: Tema.radio-pequeno;
        background: Tema.acento-tenue;
        border-width: Tema.linea;
        border-color: Tema.acento-suave;
    }

    for texto[i] in root.valores : Text {
        y: (parent.height - Tema.alto-rueda-item) / 2
            + ((i * 1.0 - root.posicion) * root.renglon) * 1px;
        width: parent.width;
        height: Tema.alto-rueda-item;
        horizontal-alignment: center;
        vertical-alignment: center;
        text: texto;
        font-family: Tema.fuente-titulos;
        font-size: i == root.centro ? Tema.tamano-texto : Tema.tamano-pequeno;
        color: i == root.centro
            ? Tema.acento
            : (Math.abs(i - root.centro) == 1 ? Tema.texto-suave : Tema.texto-tenue);
    }

    ta := TouchArea {
        mouse-cursor: pointer;

        moved => {
            root.y-ultima = self.mouse-y / 1px;
            root.posicion = root.desde + (self.pressed-y / 1px - root.y-ultima) / root.renglon;
            root.acotar();
        }

        pointer-event(evento) => {
            if evento.kind == PointerEventKind.down {
                root.desde = root.posicion;
                root.y-pulsada = self.mouse-y / 1px;
                root.y-ultima = root.y-pulsada;
            }
            if evento.kind == PointerEventKind.up {
                root.y-ultima = self.mouse-y / 1px;
                root.soltar();
            }
            EventResult.accept
        }

        scroll-event(evento) => {
            // Una muesca de la rueda, un valor: así nunca queda a medio camino.
            if evento.delta-y > 0 {
                root.posicion = Math.round(root.posicion) + 1;
                root.acotar();
                return EventResult.accept;
            }
            if evento.delta-y < 0 {
                root.posicion = Math.round(root.posicion) - 1;
                root.acotar();
                return EventResult.accept;
            }
            EventResult.reject
        }
    }
}

export component Selector inherits Rectangle {
    // 1 = fecha · 2 = hora · 3 = materia
    in property <int> tipo: 0;
    in property <string> titulo: "";

    // Fecha.
    in property <string> etiqueta-mes: "";
    in property <[CeldaDia]> celdas: [];

    // Hora: dos ruedas (1–12 y 00–59) y el selector a. m. / p. m.
    in property <string> hora-texto: "";
    in property <int> hora-inicial: 0;
    in property <int> minuto-inicial: 0;
    in property <bool> tarde: false;
    in property <[string]> horas: [];
    in property <[string]> minutos: [];

    // Materia.
    in property <[MateriaUI]> materias: [];
    in-out property <string> materia-nueva: "";
    in-out property <bool> escribiendo: false;

    callback cerrar();
    callback mes(int);
    callback dia(int);
    callback hora12(int);
    callback minuto(int);
    callback periodo(bool);
    callback aceptar();
    callback escribir();
    callback materia(string);

    background: Tema.fondo-velo;

    // El velo se come los clics: nada de lo de abajo se activa por accidente.
    TouchArea {
        clicked => { }
    }

    panel := Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: Tema.ancho-selector;
        height: Tema.alto-selector;
        background: Tema.fondo-panel;
        border-radius: Tema.radio;
        border-width: Tema.linea;
        border-color: Tema.borde-fuerte;

        VerticalLayout {
            x: Tema.espacio-lg;
            y: Tema.espacio-lg;
            width: parent.width - 2 * Tema.espacio-lg;
            height: parent.height - 2 * Tema.espacio-lg;
            spacing: Tema.espacio-md;

            Text {
                height: Tema.espacio-lg;
                vertical-alignment: center;
                text: root.titulo;
                font-family: Tema.fuente-titulos;
                font-size: Tema.tamano-seccion;
                letter-spacing: Tema.letra-seccion;
                color: Tema.texto;
                overflow: elide;
            }

            // --- Calendario ------------------------------------------------
            if root.tipo == 1 : VerticalLayout {
                spacing: Tema.espacio-sm;

                HorizontalLayout {
                    spacing: Tema.espacio-xs;
                    cross-axis-alignment: center;

                    Boton {
                        texto: "‹";
                        width: Tema.ancho-boton-nav-mes;
                        clicked => { root.mes(-1); }
                    }

                    Text {
                        horizontal-stretch: 1;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        text: root.etiqueta-mes;
                        font-size: Tema.tamano-texto;
                        color: Tema.texto;
                        overflow: elide;
                    }

                    Boton {
                        texto: "›";
                        width: Tema.ancho-boton-nav-mes;
                        clicked => { root.mes(1); }
                    }
                }

                HorizontalLayout {
                    spacing: Tema.espacio-2xs;

                    for letra in ["L", "M", "X", "J", "V", "S", "D"] : Text {
                        width: Tema.ancho-celda-dia;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        text: letra;
                        font-family: Tema.fuente-titulos;
                        font-size: Tema.tamano-hora;
                        color: Tema.texto-tenue;
                    }
                }

                GridLayout {
                    spacing: Tema.espacio-2xs;

                    for celda in root.celdas : Rectangle {
                        row: celda.fila;
                        col: celda.columna;
                        width: Tema.ancho-celda-dia;
                        height: Tema.alto-celda-dia;
                        border-radius: Tema.radio-pequeno;
                        background: celda.elegida ? Tema.acento-tenue : (celda.dia > 0 && celda-ta.has-hover ? Tema.fondo-hover : transparent);
                        border-width: Tema.linea;
                        border-color: celda.elegida ? Tema.acento : (celda.hoy ? Tema.acento-suave : transparent);
                        visible: celda.dia > 0;

                        Text {
                            width: parent.width;
                            height: parent.height;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            text: "\{celda.dia}";
                            font-size: Tema.tamano-pequeno;
                            color: celda.elegida ? Tema.acento : (celda.hoy ? Tema.texto : Tema.texto-suave);
                        }

                        celda-ta := TouchArea {
                            enabled: celda.dia > 0;
                            mouse-cursor: pointer;
                            clicked => { root.dia(celda.dia); }
                        }
                    }
                }
            }

            // --- Hora: ruedas ------------------------------------------------
            if root.tipo == 2 : VerticalLayout {
                spacing: Tema.espacio-sm;

                Text {
                    height: Tema.alto-boton;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    text: root.hora-texto;
                    font-family: Tema.fuente-titulos;
                    font-size: Tema.tamano-titulo;
                    letter-spacing: Tema.letra-titulo;
                    color: Tema.acento;
                }

                HorizontalLayout {
                    height: Tema.alto-rueda;
                    spacing: Tema.espacio-md;
                    alignment: center;

                    Rueda {
                        width: Tema.ancho-rueda;
                        valores: root.horas;
                        inicial: root.hora-inicial;
                        elegido(valor) => { root.hora12(valor); }
                    }

                    Text {
                        width: Tema.espacio-md;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        text: ":";
                        font-family: Tema.fuente-titulos;
                        font-size: Tema.tamano-titulo;
                        color: Tema.texto-suave;
                    }

                    Rueda {
                        width: Tema.ancho-rueda;
                        valores: root.minutos;
                        inicial: root.minuto-inicial;
                        elegido(valor) => { root.minuto(valor); }
                    }
                }

                HorizontalLayout {
                    spacing: Tema.espacio-xs;
                    alignment: center;

                    Chip {
                        texto: "a. m.";
                        ancho: Tema.ancho-chip-meridiemo;
                        activo: !root.tarde;
                        clicked => { root.periodo(false); }
                    }

                    Chip {
                        texto: "p. m.";
                        ancho: Tema.ancho-chip-meridiemo;
                        activo: root.tarde;
                        clicked => { root.periodo(true); }
                    }
                }

                Text {
                    height: Tema.espacio-lg;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    text: "Rueda del ratón o arrastra; se guarda en 24 h.";
                    font-size: Tema.tamano-hora;
                    color: Tema.texto-tenue;
                }
            }

            // --- Materia ---------------------------------------------------
            if root.tipo == 3 : VerticalLayout {
                spacing: Tema.espacio-sm;

                if !root.escribiendo : VerticalLayout {
                    spacing: Tema.espacio-sm;

                    ScrollView {
                        height: Tema.alto-lista-selector;

                        VerticalLayout {
                            spacing: Tema.espacio-2xs;

                            FichaMateria {
                                texto: "Sin materia";
                                tono: 8;
                                clicked => { root.materia(""); }
                            }

                            for materia in root.materias : FichaMateria {
                                texto: materia.nombre;
                                tono: materia.tono;
                                clicked => { root.materia(materia.nombre); }
                            }

                            if root.materias.length == 0 : Text {
                                height: Tema.alto-fila-selector;
                                vertical-alignment: center;
                                text: "Aún no hay materias en el archivo.";
                                font-size: Tema.tamano-pequeno;
                                color: Tema.texto-tenue;
                            }
                        }
                    }

                    Boton {
                        texto: "Escribir una nueva";
                        width: Tema.ancho-boton-largo;
                        clicked => { root.escribir(); }
                    }
                }

                if root.escribiendo : VerticalLayout {
                    spacing: Tema.espacio-sm;

                    Campo {
                        etiqueta: "Materia nueva";
                        texto <=> root.materia-nueva;
                        pista: "Cálculo";
                    }

                    Text {
                        height: Tema.alto-fila-selector;
                        vertical-alignment: center;
                        text: "Si coincide con una existente, se guarda con su grafía.";
                        font-size: Tema.tamano-hora;
                        color: Tema.texto-tenue;
                        overflow: elide;
                    }
                }
            }

            Rectangle { vertical-stretch: 1; }

            HorizontalLayout {
                alignment: end;
                spacing: Tema.espacio-sm;

                Rectangle { horizontal-stretch: 1; }

                Boton {
                    texto: "Cancelar";
                    clicked => { root.cerrar(); }
                }

                if root.tipo != 3 || root.escribiendo : Boton {
                    texto: "Aceptar";
                    principal: true;
                    clicked => { root.aceptar(); }
                }
            }
        }
    }
}
